{
    "name": "acencyril/sentinelle-bundle",
    "type": "symfony-bundle",
    "description": "Blocks attackers, never your mail provider. Intrusion detection for Symfony.",
    "keywords": [
        "symfony",
        "security",
        "ip-blocking",
        "intrusion-detection",
        "waf",
        "fail2ban"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Cyril",
            "homepage": "https://github.com/acencyril"
        }
    ],
    "require": {
        "php": ">=8.1",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/orm": "^2.17 || ^3.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/mailer": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "psr/cache": "^2.0 || ^3.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Acencyril\\SentinelleBundle\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Acencyril\\SentinelleBundle\\Tests\\": "tests/"
        }
    }
}
