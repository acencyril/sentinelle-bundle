{# The parent template comes from configuration: a bundle cannot know how the
   application installing it dresses its pages. #}
{% extends parent_template %}

{% block title %}Site activity{% endblock %}

{% block body %}
  {# "IP blocked" follows the text colour (currentColor): a fixed dark grey was
     unreadable on dark admin themes. #}
  {% set colour = {
    'attack_attempt': '#b91c1c', 'ip_blocked': 'currentColor', 'scan_probe': '#c2410c',
    'access_denied': '#a16207', 'server_error': '#7c3aed', 'not_found': '#64748b',
    'client_error': '#64748b', 'page_view': '#059669', 'human_pass': '#0891b2'
  } %}
  {% set label = {
    'attack_attempt': 'exploitation attempt', 'ip_blocked': 'IP blocked', 'human_pass': 'human pass',
    'scan_probe': 'probe', 'access_denied': 'access denied',
    'server_error': 'server error', 'not_found': 'not found',
    'client_error': 'client error', 'page_view': 'page view'
  } %}

  {# The owner's name under each address. Without it the table shows only
   numbers and you block at random — which is exactly how a critical provider
   IP was once banned by hand, breaking a working part of the site. #}
  {% macro who(ip, identities) %}
    {% set id = identities[ip]|default(null) %}
    {% if id and id.label %}
      <div style="font-size:.69rem;color:{{ id.critical ? '#b91c1c' : '#6b7280' }}">
        {{ id.critical ? '⛔ ' }}{{ id.label }}{{ id.critical ? ' — do not block' }}
      </div>
    {% elseif id and id.hostname %}
      <div style="font-size:.69rem;color:#6b7280">{{ id.hostname }}</div>
    {% elseif id %}
      <div style="font-size:.69rem;color:#9ca3af;font-style:italic">unknown (no reverse DNS)</div>
    {% endif %}
  {% endmacro %}
  {% import _self as w %}

  <h1>Site activity</h1>
  {% if back_route %}<p><a href="{{ path(back_route) }}">← back</a></p>{% endif %}

  {% for message in app.flashes('sentinelle_success') %}
    <p style="color:#059669">{{ message }}</p>
  {% endfor %}
  {% for message in app.flashes('sentinelle_error') %}
    <p style="color:#b91c1c">{{ message }}</p>
  {% endfor %}

  <h2>Last 24 hours</h2>
  <p>
    {% for kind, total in summary %}
    <span style="color:{{ colour[kind]|default('#64748b') }}">
      {{ label[kind]|default(kind) }}: <strong>{{ total }}</strong></span>{{ not loop.last ? ' · ' }}
    {% else %}
      <span style="color:#9ca3af">Nothing to report.</span>
    {% endfor %}
  </p>
  {% if summary.human_pass is defined %}
    {# People behind a blocked address (office, carrier, school) who proved they
       were browsers and were let through. #}
    <p style="font-size:.85rem">{{ summary.human_pass }} human pass{{ summary.human_pass > 1 ? 'es' }} granted to browsers behind a blocked address.</p>
  {% endif %}

  {% if blocked is not empty %}
    <h2>Blocked addresses</h2>
    <table>
      <tr><th>address</th><th>source</th><th>reason</th><th>until</th><th>strikes</th><th>hits</th><th></th></tr>
      {% for e in blocked %}
        <tr>
          <td>{{ e.ip }}{{ w.who(e.ip, identities) }}</td>
          <td>{{ e.source == 'manual' ? 'manual' : 'auto' }}</td>
          <td>{{ e.reason }}</td>
          <td>{{ e.isPermanent ? 'permanent' : e.expiresAt|date('Y-m-d H:i') }}</td>
          <td>{{ e.strikes > 1 ? e.strikes : '—' }}</td>
          <td>{{ e.hitCount ?: '—' }}</td>
          <td>
            <form method="post" action="{{ path('sentinelle_unblock') }}">
              <input type="hidden" name="_token" value="{{ csrf_token('sentinelle_block') }}">
              <input type="hidden" name="ip" value="{{ e.ip }}">
              <button type="submit">unblock</button>
            </form>
          </td>
        </tr>
      {% endfor %}
    </table>
  {% endif %}

  {% if topIps is not empty %}
    <h2>Most active addresses over 7 days</h2>
    <table>
      <tr><th>address</th><th>anomalies</th><th>last</th><th></th></tr>
      {% for r in topIps %}
        <tr>
          <td>{{ r.ip }}{{ w.who(r.ip, identities) }}</td>
          <td>{{ r.total }}</td>
          <td>{{ r.last|date('Y-m-d H:i') }}</td>
          <td>
            {% if blockedByIp[r.ip] is defined %}
              <span style="color:#9ca3af">already blocked</span>
            {% else %}
              {# Manual blocks are permanent by default: blocking by hand is a
               deliberate decision, not a detection. #}
              <form method="post" action="{{ path('sentinelle_block') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('sentinelle_block') }}">
                <input type="hidden" name="ip" value="{{ r.ip }}">
                <button type="submit">block</button>
              </form>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>
  {% endif %}

  <h2>Log</h2>
  <p>
    <a href="{{ path('sentinelle_activity') }}">all</a> ·
    <a href="{{ path('sentinelle_activity', {filter: 'suspicious'}) }}">anomalies only</a>
  </p>
  <table>
    <tr><th>when</th><th>kind</th><th>address</th><th>url</th><th>status</th><th>agent</th></tr>
    {% for e in events %}
      <tr>
        <td>{{ e.createdAt|date('m-d H:i:s') }}</td>
        <td style="color:{{ colour[e.eventType]|default('#64748b') }}">{{ label[e.eventType]|default(e.eventType) }}</td>
        <td>{{ e.ip ?: '—' }}{% if e.ip %}{{ w.who(e.ip, identities) }}{% endif %}</td>
        <td style="word-break:break-all">
          {{ e.url }}
          {# The pattern lives in the query string, which was not displayed.
           `insert()` only records the path; what triggered the detection lives
           in `meta`. Two exploitation attempts therefore appeared as two
           identical "/" rows. An alert must show what was attempted, not just
           that something happened. #}
          {% if e.meta.pattern is defined %}
            <div style="font-size:.69rem;color:#b91c1c">pattern: {{ e.meta.pattern }}</div>
          {% endif %}
          {% if e.meta.query is defined %}
            <div style="font-size:.69rem;color:#9ca3af">?{{ e.meta.query|slice(0, 120) }}</div>
          {% endif %}
        </td>
        <td>{{ e.statusCode ?: '—' }}</td>
        <td style="font-size:.69rem;color:#9ca3af">{{ e.userAgent|slice(0, 60) }}</td>
      </tr>
    {% else %}
      <tr><td colspan="6">No visits recorded.</td></tr>
    {% endfor %}
  </table>
{% endblock %}